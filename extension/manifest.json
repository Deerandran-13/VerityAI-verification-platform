{
  "manifest_version": 3,
  "name": "VerityAI - AI Information & Freshness Engine",
  "version": "1.0.0",
  "description": "Verify AI-generated text, detect hallucinations, outdated information, and check live web citations.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:5173/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "VerityAI Fact Verifier"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}

