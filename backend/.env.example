# Database
DATABASE_URL=postgresql+asyncpg://verityai:verityai@localhost:5432/verityai
DATABASE_URL_SYNC=postgresql://verityai:verityai@localhost:5432/verityai

# API Keys (set these with your actual keys)
TAVILY_API_KEY=your_tavily_api_key_here
BIFROST_API_KEY=your_bifrost_api_key_here
BIFROST_BASE_URL=http://127.0.0.1:8080/v1
BIFROST_MODEL=gemini/gemini-2.5-flash

# Application
APP_NAME=VerityAI
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_SIZE_MB=10
